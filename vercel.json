{
  "buildCommand": "",
  "framework": null,
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "uat.customize.luckycolorstone.com"
        }
      ],
      "dest": "/index.html"
    },
    {
      "src": "/api/liff-config",
      "dest": "/api/liff-config.js"
    },
    {
      "src": "/line-auth-entry",
      "dest": "/line-auth-entry.html"
    },
    {
      "src": "/api/line-auth-entry",
      "dest": "/api/line-auth-entry.js"
    },
    {
      "src": "/api/line-auth-consume",
      "dest": "/api/line-auth-consume.js"
    },
    {
      "src": "/ig-android-escape",
      "dest": "https://lucky-colorstone-uat.onrender.com/ig-android-escape"
    },
    {
      "src": "/ig-android-chrome-escape",
      "dest": "https://lucky-colorstone-uat.onrender.com/ig-android-chrome-escape"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://lucky-colorstone-uat.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
