{
  "buildCommand": "",
  "framework": null,
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "uat.customize.luckycolorstone.com"
        }
      ],
      "dest": "/index.html"
    },
    {
      "src": "/api/liff-config",
      "dest": "/api/liff-config.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://lucky-colorstone-uat.onrender.com/api/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
